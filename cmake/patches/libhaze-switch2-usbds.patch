         constexpr const u32 DefaultInterfaceNumber = USBDS_DEFAULT_InterfaceNumber;
 
+#if defined(__SWITCH2__)
+        /* Switch 2's usb:ds takes Switch 1 11.0.0's commands, except on the
+         * interface: AppendConfigurationData is command 6 (Switch 1: 10), and
+         * the control transfer events that usbDsRegisterInterface asks for
+         * (command 5) fail. So the interface and its endpoints are registered
+         * here, as OunceMTP does (github.com/venustrikes/ouncemtp, ISC). */
+        constexpr const char *ProductName = "Nintendo Switch 2";
+        constexpr u8 InterfaceSlots = 4;
+
+        constinit UsbDsInterface g_interface;
+        constinit UsbDsEndpoint g_endpoints[UsbSessionEndpoint_Count];
+        constinit u32 g_endpoint_count;
+
+        Result RegisterInterface(UsbDsInterface **out) {
+            Service *ds = usbDsGetServiceSession();
+            Result rc = 0;
+            for (u8 slot = 0; slot < InterfaceSlots; slot++) {
+                g_interface = {};
+                serviceAssumeDomain(ds);
+                rc = serviceDispatchIn(ds, 1, slot, .out_num_objects = 1, .out_objects = std::addressof(g_interface.s));
+                if (R_SUCCEEDED(rc)) {
+                    g_interface.initialized = true;
+                    g_interface.interface_index = slot;
+                    *out = std::addressof(g_interface);
+                    R_SUCCEED();
+                }
+            }
+            R_RETURN(rc);
+        }
+
+        Result AppendConfigurationData(UsbDsInterface *interface, UsbDeviceSpeed speed, const void *buffer, size_t size) {
+            const u32 in = speed;
+            serviceAssumeDomain(std::addressof(interface->s));
+            R_RETURN(serviceDispatchIn(std::addressof(interface->s), 6, in,
+                .buffer_attrs = { SfBufferAttr_HipcMapAlias | SfBufferAttr_In },
+                .buffers = { { buffer, size } }));
+        }
+
+        Result RegisterEndpoint(UsbDsInterface *interface, UsbDsEndpoint **out, u8 address) {
+            UsbDsEndpoint *endpoint = std::addressof(g_endpoints[g_endpoint_count]);
+            *endpoint = {};
+            serviceAssumeDomain(std::addressof(interface->s));
+            R_TRY(serviceDispatchIn(std::addressof(interface->s), 0, address, .out_num_objects = 1, .out_objects = std::addressof(endpoint->s)));
+            endpoint->initialized = true;
+            g_endpoint_count++;
+
+            Handle event = INVALID_HANDLE;
+            serviceAssumeDomain(std::addressof(endpoint->s));
+            R_TRY(serviceDispatch(std::addressof(endpoint->s), 2, .out_handle_attrs = { SfOutHandleAttr_HipcCopy }, .out_handles = std::addressof(event)));
+            eventLoadRemote(std::addressof(endpoint->CompletionEvent), event, false);
+
+            *out = endpoint;
+            R_SUCCEED();
+        }
+
+        /* usbDsExit only closes the objects libounce registered. */
+        void ReleaseObjects() {
+            for (u32 i = 0; i < g_endpoint_count; i++) {
+                UsbDsEndpoint *endpoint = std::addressof(g_endpoints[i]);
+                usbDsEndpoint_Cancel(endpoint);
+                eventClose(std::addressof(endpoint->CompletionEvent));
+                serviceAssumeDomain(std::addressof(endpoint->s));
+                serviceClose(std::addressof(endpoint->s));
+                endpoint->initialized = false;
+            }
+            g_endpoint_count = 0;
+
+            if (g_interface.initialized) {
+                serviceAssumeDomain(std::addressof(g_interface.s));
+                serviceClose(std::addressof(g_interface.s));
+                g_interface.initialized = false;
+            }
+        }
+#else
+        constexpr const char *ProductName = "Nintendo Switch";
+
+        Result RegisterInterface(UsbDsInterface **out) {
+            R_RETURN(usbDsRegisterInterface(out));
+        }
+
+        Result AppendConfigurationData(UsbDsInterface *interface, UsbDeviceSpeed speed, const void *buffer, size_t size) {
+            R_RETURN(usbDsInterface_AppendConfigurationData(interface, speed, buffer, size));
+        }
+
+        Result RegisterEndpoint(UsbDsInterface *interface, UsbDsEndpoint **out, u8 address) {
+            R_RETURN(usbDsInterface_RegisterEndpoint(interface, out, address));
+        }
+
+        void ReleaseObjects() { /* ... */ }
+#endif
+
     }
 
